{
  "name": "mqtt-llm-application-state-control",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Reproducible Mosquitto and LLM experiments for deadline- and quality-aware MQTT application-state control.",
  "scripts": {
    "test": "node tests/test_core.mjs",
    "tasks:export": "node datasets/export_task_corpus.mjs",
    "profile:journal": "node subscribers/run_quality_profiles.mjs",
    "experiment": "node controller/run_live_experiment.mjs",
    "experiment:matrix": "node controller/run_live_matrix.mjs",
    "experiment:journal": "node controller/run_journal_campaign.mjs",
    "simulate": "node workloads/run_simulation.mjs",
    "analyze": "node analysis/analyze_journal_results.mjs",
    "validate": "node analysis/validate_artifact.mjs",
    "validate:professor": "node analysis/validate_professor_experiments.mjs",
    "manifest": "node analysis/generate_manifest.mjs",
    "figures": "node analysis/generate_journal_figures.mjs && node analysis/render_figures.mjs --dir figures",
    "render:paper": "node analysis/render_manuscript_preview.mjs",
    "build:paper-single": "node analysis/build_single_file_manuscript.mjs",
    "artifact": "npm run analyze && npm run figures"
  },
  "dependencies": {
    "mqtt": "5.14.1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "pdf-parse": "^2.4.5"
  }
}
